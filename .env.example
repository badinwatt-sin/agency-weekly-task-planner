# Copy to .env.local for local development. In production set these in the
# hosting provider's encrypted environment-variable settings — never commit them.

# Public (safe in the browser; access is enforced by row-level security)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Full URL the app is served from (used in invite / reset emails)
NEXT_PUBLIC_SITE_URL=https://planner.example.com

# SERVER ONLY — bypasses row-level security. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-secret-or-service-role-key

# SERVER ONLY — random 32+ character string used to hash login-throttling keys.
# Generate with: openssl rand -base64 48
AUTH_THROTTLE_SECRET=change-me

# Agency time zone for "today", overdue and week calculations.
NEXT_PUBLIC_APP_TIMEZONE=Asia/Bangkok

# SERVER ONLY — optional. Turns on "Summarize with Claude" for meeting notes.
# Create a key at https://platform.claude.com (pay per use; a typical weekly
# meeting summary costs a few US cents). Leave empty to hide the feature.
ANTHROPIC_API_KEY=
# Optional: which Claude model writes the summaries.
ANTHROPIC_MODEL=claude-sonnet-5-5
